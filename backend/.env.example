# Tourister Trip Planner - Backend Environment Variables

# Web Server Port
PORT=8080

# Database Configuration (Defaults to H2 in-memory if unset)
# For production PostgreSQL (e.g. Neon, Supabase, Render PostgreSQL):
DATABASE_URL=jdbc:postgresql://ep-example.neon.tech/touristerdb?sslmode=require
DATABASE_DRIVER=org.postgresql.Driver
DATABASE_USERNAME=postgres_user
DATABASE_PASSWORD=postgres_password_here
JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Security & JWT Secret (256-bit hexadecimal string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Initial Admin User Seeding Configuration
INITIAL_ADMIN_EMAIL=admin@tourister.com
INITIAL_ADMIN_PASSWORD=Admin@12345
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_PHONE=+1-800-555-0199

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://tourister-planner.vercel.app
